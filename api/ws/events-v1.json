{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diegobraga92/PudimProductivity/blob/main/api/ws/events-v1.json",
  "title": "PudimProductivity WebSocket Events v1",
  "description": "Endpoint: GET /api/v1/ws. Use 'seq' for reconnection via ?last_seq=N.",

  "$defs": {
    "envelope": {
      "type": "object",
      "description": "Common envelope for all WebSocket events.",
      "required": ["type", "seq", "timestamp"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Event type, determines payload shape.",
          "enum": [
            "task.created",
            "task.updated",
            "task.deleted",
            "task.completed",
            "task.uncompleted",
            "task.merged",
            "tasklist.shared",
            "tasklist.unshared",
            "presence.online",
            "presence.offline",
            "library.item.added",
            "library.item.updated",
            "library.item.deleted",
            "library.items.imported",
            "recipe.created",
            "recipe.updated",
            "recipe.deleted",
            "stale"
          ]
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "description": "Event stream position. Use for reconnection."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "UTC timestamp in RFC3339."
        },
        "payload": {
          "description": "Event payload. Omitted for 'stale'."
        }
      }
    },

    "task": {
      "type": "object",
      "description": "Task data for create/update/merge events.",
      "required": ["id", "title", "status", "created_at", "updated_at"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "title": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["todo", "done"]
        },
        "recurrence_days": {
          "type": "array",
          "description": "Recurring days (mon-sun). Omitted if not recurring.",
          "items": {
            "type": "string",
            "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
          }
        },
        "list_id": {
          "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }],
          "description": "Task list ID, or null."
        },
        "start_time": {
          "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }],
          "description": "Scheduled start time, or null."
        },
        "end_time": {
          "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }],
          "description": "Scheduled end time, or null."
        },
        "color": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "description": "Optional color, or null."
        },
        "scheduled_date": {
          "anyOf": [{ "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, { "type": "null" }],
          "description": "Scheduled date (YYYY-MM-DD), or null."
        },
        "alarm_minutes": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }],
          "description": "Alarm offset in minutes, or null."
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },

    "taskRef": {
      "type": "object",
      "description": "Minimal reference for deleted tasks.",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "format": "uuid" }
      }
    },

    "completion": {
      "type": "object",
      "description": "Completed task info, includes title for notification.",
      "required": ["id", "task_id", "completed_date"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "task_id": { "type": "string", "format": "uuid" },
        "title": {
          "type": "string",
          "description": "Task title (for notification)."
        },
        "completed_date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Completion date (YYYY-MM-DD)."
        }
      }
    },

    "uncompletion": {
      "type": "object",
      "description": "Task marked incomplete.",
      "required": ["id", "completed_date"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Completion record ID removed."
        },
        "title": {
          "type": "string",
          "description": "Task title (for display)."
        },
        "completed_date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Completion date undone."
        }
      }
    },

    "recipe": {
      "type": "object",
      "description": "Basic recipe info for sync. Fetch full via REST API.",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "title": { "type": "string" },
        "difficulty": {
          "type": "string",
          "enum": ["easy", "medium", "hard"]
        }
      }
    },

    "recipeRef": {
      "type": "object",
      "description": "Minimal reference for deleted recipe.",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "format": "uuid" }
      }
    },

    "libraryItem": {
      "type": "object",
      "description": "Library item info for sync.",
      "required": ["id", "name", "media_type"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "media_type": {
          "type": "string",
          "enum": ["movie", "series", "book", "game"]
        },
        "release_year": {
          "anyOf": [{ "type": "integer" }, { "type": "null" }],
          "description": "Release year, or null."
        },
        "done": {
          "type": "boolean",
          "description": "Marked as done."
        },
        "notes": { "type": "string" }
      }
    },

    "libraryItemRef": {
      "type": "object",
      "description": "Minimal reference for deleted item.",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "format": "uuid" }
      }
    },

    "libraryImport": {
      "type": "object",
      "description": "Import summary: saved and skipped.",
      "required": ["imported"],
      "properties": {
        "imported": {
          "type": "integer",
          "minimum": 0,
          "description": "Items saved."
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "description": "Rows skipped."
        }
      }
    },

    "taskListShare": {
      "type": "object",
      "description": "Share/unshare task list info.",
      "required": ["list_id", "shared_with"],
      "properties": {
        "list_id": {
          "type": "string",
          "format": "uuid",
          "description": "Task list ID."
        },
        "shared_with": {
          "type": "string",
          "description": "User ID involved."
        },
        "role": {
          "type": "string",
          "enum": ["editor", "viewer"],
          "description": "Permission (editor/viewer)."
        },
        "shared_by": {
          "type": "string",
          "description": "Sharer ID (for shared)."
        },
        "removed_by": {
          "type": "string",
          "description": "Remover ID (for unshared)."
        }
      }
    },

    "presenceOnline": {
      "type": "object",
      "description": "User online presence.",
      "required": ["user_id", "list_ids"],
      "properties": {
        "user_id": { "type": "string" },
        "list_ids": {
          "type": "array",
          "description": "Accessible task list IDs.",
          "items": { "type": "string", "format": "uuid" }
        }
      }
    },

    "presenceOffline": {
      "type": "object",
      "description": "User offline presence.",
      "required": ["user_id"],
      "properties": {
        "user_id": { "type": "string" }
      }
    }
  },

  "allOf": [
    { "$ref": "#/$defs/envelope" },
    {
      "oneOf": [
        {
          "description": "New task created. Payload: complete task.",
          "properties": {
            "type": { "const": "task.created" },
            "payload": { "$ref": "#/$defs/task" }
          },
          "required": ["payload"]
        },
        {
          "description": "Existing task changed. Payload: complete task.",
          "properties": {
            "type": { "const": "task.updated" },
            "payload": { "$ref": "#/$defs/task" }
          },
          "required": ["payload"]
        },
        {
          "description": "Task deleted. Payload: taskRef.",
          "properties": {
            "type": { "const": "task.deleted" },
            "payload": { "$ref": "#/$defs/taskRef" }
          },
          "required": ["payload"]
        },
        {
          "description": "Task marked completed. Payload: completion.",
          "properties": {
            "type": { "const": "task.completed" },
            "payload": { "$ref": "#/$defs/completion" }
          },
          "required": ["payload"]
        },
        {
          "description": "Task marked incomplete. Payload: uncompletion.",
          "properties": {
            "type": { "const": "task.uncompleted" },
            "payload": { "$ref": "#/$defs/uncompletion" }
          },
          "required": ["payload"]
        },
        {
          "description": "Conflict resolved. Payload: final task.",
          "properties": {
            "type": { "const": "task.merged" },
            "payload": { "$ref": "#/$defs/task" }
          },
          "required": ["payload"]
        },
        {
          "description": "Task list shared. Payload: taskListShare.",
          "properties": {
            "type": { "const": "tasklist.shared" },
            "payload": { "$ref": "#/$defs/taskListShare" }
          },
          "required": ["payload"]
        },
        {
          "description": "Task list unshared. Payload: taskListShare.",
          "properties": {
            "type": { "const": "tasklist.unshared" },
            "payload": { "$ref": "#/$defs/taskListShare" }
          },
          "required": ["payload"]
        },
        {
          "description": "User online. Payload: presenceOnline.",
          "properties": {
            "type": { "const": "presence.online" },
            "payload": { "$ref": "#/$defs/presenceOnline" }
          },
          "required": ["payload"]
        },
        {
          "description": "User offline. Payload: presenceOffline.",
          "properties": {
            "type": { "const": "presence.offline" },
            "payload": { "$ref": "#/$defs/presenceOffline" }
          },
          "required": ["payload"]
        },
        {
          "description": "Library item added. Payload: libraryItem.",
          "properties": {
            "type": { "const": "library.item.added" },
            "payload": { "$ref": "#/$defs/libraryItem" }
          },
          "required": ["payload"]
        },
        {
          "description": "Library item updated. Payload: libraryItem.",
          "properties": {
            "type": { "const": "library.item.updated" },
            "payload": { "$ref": "#/$defs/libraryItem" }
          },
          "required": ["payload"]
        },
        {
          "description": "Library item deleted. Payload: libraryItemRef.",
          "properties": {
            "type": { "const": "library.item.deleted" },
            "payload": { "$ref": "#/$defs/libraryItemRef" }
          },
          "required": ["payload"]
        },
        {
          "description": "Library import finished. Payload: libraryImport.",
          "properties": {
            "type": { "const": "library.items.imported" },
            "payload": { "$ref": "#/$defs/libraryImport" }
          },
          "required": ["payload"]
        },
        {
          "description": "Recipe created. Payload: recipe.",
          "properties": {
            "type": { "const": "recipe.created" },
            "payload": { "$ref": "#/$defs/recipe" }
          },
          "required": ["payload"]
        },
        {
          "description": "Recipe updated. Payload: recipe.",
          "properties": {
            "type": { "const": "recipe.updated" },
            "payload": { "$ref": "#/$defs/recipe" }
          },
          "required": ["payload"]
        },
        {
          "description": "Recipe deleted. Payload: recipeRef.",
          "properties": {
            "type": { "const": "recipe.deleted" },
            "payload": { "$ref": "#/$defs/recipeRef" }
          },
          "required": ["payload"]
        },
        {
          "description": "Too many events missed. Fetch full state via REST API.",
          "properties": {
            "type": { "const": "stale" }
          },
          "not": { "required": ["payload"] }
        }
      ]
    }
  ]
}