{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diegobraga92/PudimProductivity/blob/main/api/ws/events-v1.json",
  "title": "PudimProductivity WebSocket Events v1",
  "description": "Envelope and payload shapes pushed by the backend sync hub over the WebSocket endpoint GET /api/v1/ws. The client MAY pass ?last_seq=N to resume after a disconnect; events with seq > N are replayed, or a 'stale' event is sent if the client is too far behind.",
  "definitions": {
    "envelope": {
      "type": "object",
      "required": ["type", "seq", "timestamp"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "task.created",
            "task.updated",
            "task.deleted",
            "task.completed",
            "task.uncompleted",
            "task.merged",
            "tasklist.shared",
            "tasklist.unshared",
            "presence.online",
            "presence.offline",
            "library.item.added",
            "library.item.updated",
            "library.item.deleted",
            "library.items.imported",
            "recipe.created",
            "recipe.updated",
            "recipe.deleted",
            "stale"
          ],
          "description": "Event discriminator. 'stale' is a server signal: the client missed too many events and must refetch via REST."
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "description": "Monotonically increasing per-process sequence number. Clients persist the last seen value and send it back as ?last_seq on reconnect."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "UTC event time (RFC3339)."
        },
        "payload": {
          "description": "Event-specific payload; absent for 'stale'. Shape depends on 'type' (see payloads below)."
        }
      }
    },
    "task": {
      "type": "object",
      "required": ["id", "title", "status", "created_at", "updated_at"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "title": { "type": "string" },
        "status": { "type": "string", "enum": ["todo", "done"] },
        "recurrence_days": {
          "type": "array",
          "items": { "type": "string", "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] }
        },
        "list_id": { "type": ["string", "null"] },
        "start_time": { "type": ["string", "null"] },
        "end_time": { "type": ["string", "null"] },
        "color": { "type": ["string", "null"] },
        "scheduled_date": { "type": ["string", "null"] },
        "alarm_minutes": { "type": ["integer", "null"] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "taskRef": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "type": "string", "format": "uuid" } }
    },
    "completion": {
      "type": "object",
      "required": ["id", "task_id", "completed_date"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "task_id": { "type": "string", "format": "uuid" },
        "title": { "type": "string", "description": "Task title, included since Phase 3 so notification consumers don't need a follow-up lookup." },
        "completed_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "uncompletion": {
      "type": "object",
      "required": ["id", "completed_date"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "title": { "type": "string" },
        "completed_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "recipe": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "title": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] }
      },
      "description": "Recipe event payload (Phase 5a). Minimal shape — consumers needing the full recipe fetch it via REST."
    },
    "libraryItem": {
      "type": "object",
      "required": ["id", "name", "media_type"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "media_type": { "type": "string", "enum": ["movie", "series", "book", "game"] },
        "release_year": { "type": ["integer", "null"] },
        "done": { "type": "boolean" },
        "notes": { "type": "string" }
      },
      "description": "Library item event payload. Minimal shape — consumers needing the full item fetch it via REST."
    },
    "libraryItemRef": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "format": "uuid" }
      },
      "description": "Minimal library item reference (deletion events)."
    },
    "libraryImport": {
      "type": "object",
      "required": ["imported"],
      "properties": {
        "imported": { "type": "integer", "description": "Items persisted by the import." },
        "skipped": { "type": "integer", "description": "Rows rejected during the import." }
      },
      "description": "Library bulk-import summary payload."
    },
    "taskListShare": {
      "type": "object",
      "required": ["list_id", "shared_with"],
      "properties": {
        "list_id": { "type": "string", "format": "uuid" },
        "shared_with": { "type": "string", "description": "User ID the list was shared with or revoked from." },
        "role": { "type": "string", "enum": ["editor", "viewer"] },
        "shared_by": { "type": "string", "description": "User who created the share (present on tasklist.shared)." },
        "removed_by": { "type": "string", "description": "User who revoked the share (present on tasklist.unshared)." }
      },
      "description": "Phase 8 task-list share/unshare payload."
    },
    "presenceOnline": {
      "type": "object",
      "required": ["user_id", "list_ids"],
      "properties": {
        "user_id": { "type": "string" },
        "list_ids": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" },
          "description": "Task lists the user can access at connect time."
        }
      },
      "description": "Phase 8 presence payload: a user came online."
    },
    "presenceOffline": {
      "type": "object",
      "required": ["user_id"],
      "properties": { "user_id": { "type": "string" } },
      "description": "Phase 8 presence payload: a user went offline."
    }
  },
  "allOf": [
    { "$ref": "#/definitions/envelope" },
    {
      "oneOf": [
        {
          "properties": {
            "type": { "const": "task.created" },
            "payload": { "$ref": "#/definitions/task" }
          }
        },
        {
          "properties": {
            "type": { "const": "task.updated" },
            "payload": { "$ref": "#/definitions/task" }
          }
        },
        {
          "properties": {
            "type": { "const": "task.deleted" },
            "payload": { "$ref": "#/definitions/taskRef" }
          }
        },
        {
          "properties": {
            "type": { "const": "task.completed" },
            "payload": { "$ref": "#/definitions/completion" }
          }
        },
        {
          "properties": {
            "type": { "const": "task.uncompleted" },
            "payload": { "$ref": "#/definitions/uncompletion" }
          }
        },
        {
          "description": "A CRDT merge resolved (Phase 8). Payload is the winning task state so clients can reconcile.",
          "properties": {
            "type": { "const": "task.merged" },
            "payload": { "$ref": "#/definitions/task" }
          }
        },
        {
          "properties": {
            "type": { "const": "tasklist.shared" },
            "payload": { "$ref": "#/definitions/taskListShare" }
          }
        },
        {
          "properties": {
            "type": { "const": "tasklist.unshared" },
            "payload": { "$ref": "#/definitions/taskListShare" }
          }
        },
        {
          "properties": {
            "type": { "const": "presence.online" },
            "payload": { "$ref": "#/definitions/presenceOnline" }
          }
        },
        {
          "properties": {
            "type": { "const": "presence.offline" },
            "payload": { "$ref": "#/definitions/presenceOffline" }
          }
        },
        {
          "properties": {
            "type": { "const": "library.item.added" },
            "payload": { "$ref": "#/definitions/libraryItem" }
          }
        },
        {
          "properties": {
            "type": { "const": "library.item.updated" },
            "payload": { "$ref": "#/definitions/libraryItem" }
          }
        },
        {
          "properties": {
            "type": { "const": "library.item.deleted" },
            "payload": { "$ref": "#/definitions/libraryItemRef" }
          }
        },
        {
          "properties": {
            "type": { "const": "library.items.imported" },
            "payload": { "$ref": "#/definitions/libraryImport" }
          }
        },
        {
          "properties": {
            "type": { "const": "recipe.created" },
            "payload": { "$ref": "#/definitions/recipe" }
          }
        },
        {
          "properties": {
            "type": { "const": "recipe.updated" },
            "payload": { "$ref": "#/definitions/recipe" }
          }
        },
        {
          "properties": {
            "type": { "const": "recipe.deleted" },
            "payload": { "$ref": "#/definitions/taskRef" }
          }
        },
        {
          "properties": {
            "type": { "const": "stale" }
          }
        }
      ]
    }
  ]
}
