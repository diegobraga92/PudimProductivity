{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diegobraga92/PudimProductivity/blob/main/api/ws/events-v1.json",
  "title": "PudimProductivity WebSocket Events v1",
  "description": "Envelope and payload shapes pushed by the backend sync hub over the WebSocket endpoint GET /api/v1/ws. The client MAY pass ?last_seq=N to resume after a disconnect; events with seq > N are replayed, or a 'stale' event is sent if the client is too far behind.",
  "$defs": {
    "envelope": {
      "type": "object",
      "required": [
        "type",
        "seq",
        "timestamp"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "task.created",
            "task.updated",
            "task.deleted",
            "task.completed",
            "task.uncompleted",
            "task.merged",
            "tasklist.shared",
            "tasklist.unshared",
            "presence.online",
            "presence.offline",
            "library.item.added",
            "library.item.updated",
            "library.item.deleted",
            "library.items.imported",
            "recipe.created",
            "recipe.updated",
            "recipe.deleted",
            "stale"
          ],
          "description": "Event discriminator. 'stale' is a server signal indicating that the client missed too many events and must refetch via REST."
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "description": "Monotonically increasing sequence number for the sync event stream. Clients persist the last seen value and send it as ?last_seq when reconnecting."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "UTC event time in RFC3339 format."
        },
        "payload": {
          "description": "Event-specific payload. Required for all events except 'stale'."
        }
      }
    },

    "task": {
      "type": "object",
      "required": [
        "id",
        "title",
        "status",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "todo",
            "done"
          ]
        },
        "recurrence_days": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          }
        },
        "list_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "start_time": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_time": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "scheduled_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "alarm_minutes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },

    "taskRef": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "description": "Minimal task reference used by deletion events."
    },

    "completion": {
      "type": "object",
      "required": [
        "id",
        "task_id",
        "completed_date"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string",
          "description": "Task title included so notification consumers do not need a follow-up lookup."
        },
        "completed_date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },

    "uncompletion": {
      "type": "object",
      "required": [
        "id",
        "completed_date"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string",
          "description": "Task title included so notification consumers do not need a follow-up lookup."
        },
        "completed_date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },

    "recipe": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        }
      },
      "description": "Minimal recipe representation used by WebSocket events. Consumers needing the full recipe should fetch it via REST."
    },

    "recipeRef": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "description": "Minimal recipe reference used by deletion events."
    },

    "libraryItem": {
      "type": "object",
      "required": [
        "id",
        "name",
        "media_type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "media_type": {
          "type": "string",
          "enum": [
            "movie",
            "series",
            "book",
            "game"
          ]
        },
        "release_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "done": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      },
      "description": "Minimal library item representation used by WebSocket events. Consumers needing the full item should fetch it via REST."
    },

    "libraryItemRef": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "description": "Minimal library item reference used by deletion events."
    },

    "libraryImport": {
      "type": "object",
      "required": [
        "imported"
      ],
      "properties": {
        "imported": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of items persisted by the import."
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of rows rejected during the import."
        }
      },
      "description": "Summary of a library bulk import."
    },

    "taskListShare": {
      "type": "object",
      "required": [
        "list_id",
        "shared_with"
      ],
      "properties": {
        "list_id": {
          "type": "string",
          "format": "uuid"
        },
        "shared_with": {
          "type": "string",
          "description": "User ID the list was shared with or revoked from."
        },
        "role": {
          "type": "string",
          "enum": [
            "editor",
            "viewer"
          ]
        },
        "shared_by": {
          "type": "string",
          "description": "User who created the share. Present on tasklist.shared events."
        },
        "removed_by": {
          "type": "string",
          "description": "User who revoked the share. Present on tasklist.unshared events."
        }
      },
      "description": "Task-list share or unshare payload."
    },

    "presenceOnline": {
      "type": "object",
      "required": [
        "user_id",
        "list_ids"
      ],
      "properties": {
        "user_id": {
          "type": "string"
        },
        "list_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "description": "Task lists the user can access at connect time."
        }
      },
      "description": "Presence payload indicating that a user came online."
    },

    "presenceOffline": {
      "type": "object",
      "required": [
        "user_id"
      ],
      "properties": {
        "user_id": {
          "type": "string"
        }
      },
      "description": "Presence payload indicating that a user went offline."
    }
  },

  "allOf": [
    {
      "$ref": "#/$defs/envelope"
    },
    {
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "task.created"
            },
            "payload": {
              "$ref": "#/$defs/task"
            }
          },
          "required": [
            "payload"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "task.updated"
            },
            "payload": {
              "$ref": "#/$defs/task"
            }
          },
          "required": [
            "payload"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "task.deleted"
            },
            "payload": {
              "$ref": "#/$defs/taskRef"
            }
          },
          "required": [
            "payload"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "task.completed"
            },
            "payload": {
              "$ref": "#/$defs/completion"
            }
          },
          "required": [
            "payload"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "task.uncompleted"
            },
            "payload": {
              "$ref": "#/$defs/uncompletion"
            }
          },
          "required": [
            "payload"
          ]
        },
        {
          "description": "A CRDT merge has been resolved. The payload contains the winning task state so clients can reconcile.",
          "properties": {
            "type": {
              "const": "task.merged"
            },
            "payload": {
              "$ref": "#/$defs/task"
            }
          },
          "required": [
            "payload"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "tasklist.shared"
            },
            "payload": {
              "$ref": "#/$defs/taskListShare"
            }
          },
          "required": [
            "payload"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "tasklist.unshared"
            },
            "payload": {
              "$ref": "#/$defs/taskListShare"
            }
          },
          "required": [
            "payload"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "presence.online"
            },
            "payload": {
              "$ref": "#/$defs/presenceOnline"
            }
          },
          "required": [
            "payload"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "presence.offline"
            },
            "payload": {
              "$ref": "#/$defs/presenceOffline"
            }
          },
          "required": [
            "payload"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "library.item.added"
            },
            "payload": {
              "$ref": "#/$defs/libraryItem"
            }
          },
          "required": [
            "payload"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "library.item.updated"
            },
            "payload": {
              "$ref": "#/$defs/libraryItem"
            }
          },
          "required": [
            "payload"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "library.item.deleted"
            },
            "payload": {
              "$ref": "#/$defs/libraryItemRef"
            }
          },
          "required": [
            "payload"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "library.items.imported"
            },
            "payload": {
              "$ref": "#/$defs/libraryImport"
            }
          },
          "required": [
            "payload"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "recipe.created"
            },
            "payload": {
              "$ref": "#/$defs/recipe"
            }
          },
          "required": [
            "payload"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "recipe.updated"
            },
            "payload": {
              "$ref": "#/$defs/recipe"
            }
          },
          "required": [
            "payload"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "recipe.deleted"
            },
            "payload": {
              "$ref": "#/$defs/recipeRef"
            }
          },
          "required": [
            "payload"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "stale"
            }
          },
          "not": {
            "required": [
              "payload"
            ]
          }
        }
      ]
    }
  ]
}
