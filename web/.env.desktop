# Desktop (Electron) build: point the SPA at the Go backend directly, since the
# desktop shell has no nginx/Vite proxy. The WebSocket URL is derived from this
# base automatically (see web/src/api/sync.ts buildWsUrl). Loaded only when the
# web app is built with `--mode desktop` (npm run build:desktop).
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Only set when a media backend (S3/CDN) is configured.
# VITE_MEDIA_BASE_URL=http://localhost:8080/api/v1/media
