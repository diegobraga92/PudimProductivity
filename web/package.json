{
  "name": "pudimproductivity-web",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:api": "node scripts/generate-api-types.mjs",
    "check:api": "npm run generate:api && git diff --exit-code -- src/api/generated",
    "build:analyze": "ANALYZE=1 npm run build",
    "build:desktop": "vite build --mode desktop"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "knip": "^6.44.1",
    "openapi-typescript": "^7.13.0",
    "rollup-plugin-visualizer": "^7.1.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
