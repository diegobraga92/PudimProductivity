# Copy this file to .env and fill in real values before running docker compose.
# Never commit .env to version control.

# ── General ───────────────────────────────────────────────────────────────────
VERSION=0.0.1

# ── Ports (change if defaults collide with other services on your host) ───────
BACKEND_PORT=8080
FRONTEND_PORT=3000
DB_PORT=5433
REDIS_PORT=6379

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=pudim
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=pudimproductivity

# ── Backend ───────────────────────────────────────────────────────────────────
# Used when connecting from the host (not inside Docker).
DATABASE_URL=postgres://pudim:change_me_in_production@localhost:${DB_PORT:-5433}/pudimproductivity?sslmode=disable
LOG_LEVEL=info
READ_TIMEOUT=10s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s
REQUEST_TIMEOUT=15s

# Database Conns
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLETIME=5m

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used inside Docker: redis:6379; from host: localhost:${REDIS_PORT:-6379}
# Backs the cross-instance sync fan-out (pub/sub) and the task read-through cache.
REDIS_URL=redis://localhost:${REDIS_PORT:-6379}/0
# How long cached task reads are kept before they expire (stale entries are also
# invalidated immediately on every task mutation via a version bump).
REDIS_CACHE_TTL=30s

# ── OpenTelemetry (Phase 6) ──────────────────────────────────────────────────
# OTLP/HTTP collector endpoint. Empty = spans exported to stdout only.
# To view traces in Jaeger: set this to http://jaeger:4318 and run
#   docker compose --profile tracing up
# then open http://localhost:16686.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Phase 3 — Notifications ──────────────────────────────────────────────────
# Firebase Cloud Messaging device token for push. Empty = push disabled.
# Requires GOOGLE_APPLICATION_CREDENTIALS pointing at a service-account JSON.
FCM_DEVICE_TOKEN=

# ── RabbitMQ (Phase 3) ───────────────────────────────────────────────────────
RABBITMQ_USER=pudim
RABBITMQ_PASS=change_me_in_production
# The host-run backend (./scripts/run.sh) reaches the compose RabbitMQ on the
# host-mapped port. Without this the backend falls back to the docker-compose
# hostname "rabbitmq", which does not resolve on the host.
RABBITMQ_URL=amqp://pudim:change_me_in_production@localhost:5672/

# ── Library score lookup (Phase 5b) ───────────────────────────────────────────
# Configurable rating providers for the library. Each media type picks a
# provider by name ("" or "none" disables it for that type). The feature is
# also gated by the 'library.score_lookup_enabled' feature flag (off by default).
# Providers currently registered: omdb (films/series → IMDb rating), rawg
# (games → Metacritic rating).
#
# ⚠️ These variables are now a ONE-TIME BOOTSTRAP only: the provider selection
# and API keys live in the database and are edited at runtime via the admin UI
# (Server Settings → score providers, GET/PUT /api/v1/admin/score-providers).
# The .env values seed the config on the very first start; after the first save
# in the UI the database is authoritative and these are ignored.
# SCORE_PROVIDER_MOVIE=omdb
# SCORE_PROVIDER_SERIES=omdb
# SCORE_PROVIDER_GAME=rawg
# SCORE_PROVIDER_BOOK=none
# OMDB_API_KEY=
# RAWG_API_KEY=
# Optional base-URL overrides (mirrors/self-hosted endpoints, tests).
# OMDB_BASE_URL=https://www.omdbapi.com
# RAWG_BASE_URL=https://api.rawg.io/api

# ── Media storage (recipe images) ─────────────────────────────────────────────
# Backend storage selection, in priority order:
#   1. S3_MEDIA_BUCKET            — real S3 or any S3-compatible store (MinIO…)
#   2. MEDIA_STORAGE=local        — save uploads on this server's local disk
# If neither is set, recipe image uploads are disabled (degraded mode).
# S3_MEDIA_BUCKET=
# S3_MEDIA_REGION=us-east-1
# MEDIA_STORAGE=local
# MEDIA_LOCAL_DIR=./data/media
# MEDIA_PUBLIC_BASE_URL=/api/v1/media   # base of the PUT/GET media routes

# ── Soundscape ambient sounds ─────────────────────────────────────────────────
# Loop files (MP3) served at /api/v1/sounds and played by the Soundscape
# feature. Defaults ship inside the backend image (backend/sounds) and are
# seeded into SOUNDS_DIR on startup; existing files are never overwritten, so a
# sound can be overridden by dropping a file with the same name into the served
# directory (the soundsdata volume in docker-compose).
# SOUNDS_DIR=/app/sounds

# ── Web (frontend) ────────────────────────────────────────────────────────────
# Base URL used to resolve stored recipe image keys to viewable URLs.
# - Local disk: set to "/api/v1/media" (relative — served via the /api proxy).
# - S3/S3-compatible: set to the bucket/CDN public base URL.
# Leave empty only when no media backend is configured.
# VITE_MEDIA_BASE_URL=/api/v1/media
# VITE_API_BASE_URL=/api/v1

# ── Backend: CORS for cross-origin clients ──────────────────────────────────
# Comma-separated list of request Origins allowed to call the API (exact match).
# The Electron desktop app serves the SPA from the app://bundle origin, so to
# use it you must allow that origin here. Leave empty to keep the same-origin
# behavior used by the web/nginx deployment.
# CORS_ALLOWED_ORIGINS=app://bundle

