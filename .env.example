# Copy this file to .env and fill in real values before running docker compose
# (or ./scripts/run.sh for the local dev stack). Never commit .env to version control.

# ── General ───────────────────────────────────────────────────────────────────
VERSION=0.0.1

# ── Ports (change if defaults collide with other services on your host) ───────
BACKEND_PORT=8080
FRONTEND_PORT=3000
DB_PORT=5433
REDIS_PORT=6379

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=pudim
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=pudimproductivity

# ── Backend ───────────────────────────────────────────────────────────────────
# Host-run connection (./scripts/run.sh sources this .env); inside Docker the
# compose file builds its own URL from the POSTGRES_* values above.
DATABASE_URL=postgres://pudim:change_me_in_production@localhost:${DB_PORT:-5433}/pudimproductivity?sslmode=disable
LOG_LEVEL=info
READ_TIMEOUT=10s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s
REQUEST_TIMEOUT=15s
SHUTDOWN_TIMEOUT=15s

# Database conns
DATABASE_CONNECT_TIMEOUT=30s
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLETIME=5m

# ── Redis ─────────────────────────────────────────────────────────────────────
# Host-run connection (inside Docker the compose file points the backend at
# redis:6379 directly). Backs the cross-instance sync fan-out (pub/sub) and the
# task read-through cache.
REDIS_URL=redis://localhost:${REDIS_PORT:-6379}/0
# How long cached task reads are kept before they expire (stale entries are also
# invalidated immediately on every task mutation via a version bump).
REDIS_CACHE_TTL=30s

# ── OpenTelemetry ───────────────────────────────────────────────────────────
# OTLP/HTTP collector endpoint. Empty = spans exported to stdout only.
# To view traces in Jaeger: set this to http://jaeger:4318 and run
#   docker compose --profile tracing up
# then open http://localhost:16686.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Library score lookup ──────────────────────────────────────────────────────
# Rating providers for the library. Each media type picks a provider by name
# ("" or "none" disables it for that type); the feature is also gated by the
# 'library.score_lookup_enabled' feature flag (off by default). Providers
# registered: omdb (films/series → Metacritic score with IMDb fallback), rawg
# (games → Metacritic rating), igdb (games → IGDB aggregated rating, sourced
# from Metacritic/OpenCritic, with community rating fallback).
#
# ⚠️ One-time bootstrap only: provider selection and API keys live in the
# database and are edited at runtime via the admin UI (Server Settings → score
# providers, GET/PUT /api/v1/admin/score-providers). These .env values seed the
# config on the very first start; once saved in the UI the database is
# authoritative and these are ignored.
# SCORE_PROVIDER_MOVIE=omdb
# SCORE_PROVIDER_SERIES=omdb
# SCORE_PROVIDER_GAME=igdb
# SCORE_PROVIDER_BOOK=none
# OMDB_API_KEY=
# RAWG_API_KEY=
# IGDB_CLIENT_ID=                 # Twitch application Client ID
# IGDB_CLIENT_SECRET=             # Twitch application Client Secret
# Optional base-URL overrides (mirrors/self-hosted endpoints, tests).
# OMDB_BASE_URL=https://www.omdbapi.com
# RAWG_BASE_URL=https://api.rawg.io/api
# IGDB_BASE_URL=https://api.igdb.com/v4
# IGDB_TOKEN_URL=https://id.twitch.tv/oauth2/token

# ── Media storage (recipe images) ─────────────────────────────────────────────
# Backend storage selection, in priority order:
#   1. S3_MEDIA_BUCKET            — real S3 or any S3-compatible store (MinIO…)
#   2. MEDIA_STORAGE=local        — save uploads on this server's local disk
# If neither is set, recipe image uploads are disabled (degraded mode).
# S3_MEDIA_BUCKET=
# S3_MEDIA_REGION=us-east-1
# MEDIA_STORAGE=local
# MEDIA_LOCAL_DIR=./data/media
# MEDIA_PUBLIC_BASE_URL=/api/v1/media   # base of the PUT/GET media routes

# ── Soundscape ambient sounds ─────────────────────────────────────────────────
# Loop files (MP3) served at /api/v1/sounds. Defaults ship inside the backend
# image (backend/sounds) and are seeded into SOUNDS_DIR on startup; existing
# files are never overwritten, so dropping a file with the same name into the
# served directory (the soundsdata volume in docker-compose) overrides it.
# SOUNDS_DIR=/app/sounds

# ── Web (frontend) ────────────────────────────────────────────────────────────
# Build-time Vite variables — set them in web/.env.desktop or web/.env; the
# root .env above is not read by the frontend build.
# VITE_API_BASE_URL=/api/v1            # empty → same-origin /api proxy
# VITE_MEDIA_BASE_URL=/api/v1/media    # resolves recipe image keys to viewable
#                                      # URLs; for S3 use the bucket/CDN base URL

# ── Backend: CORS for cross-origin clients ──────────────────────────────────
# Comma-separated list of request Origins allowed to call the API (exact match).
# The Electron desktop app serves the SPA from the app://bundle origin, so add
# that origin here to use it. Leave empty for the same-origin web/nginx setup.
# CORS_ALLOWED_ORIGINS=app://bundle

