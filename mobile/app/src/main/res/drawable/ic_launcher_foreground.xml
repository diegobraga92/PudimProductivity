<?xml version="1.0" encoding="utf-8"?>
<!--
  PudimProductivity launcher foreground.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.185"
        android:scaleY="0.185"
        android:translateX="6.64"
        android:translateY="3.68">

        <!-- Caramel dish -->
        <path
            android:fillColor="#D08A3C"
            android:pathData="M96,320 a160,112 0 1,0 320,0 a160,112 0 1,0 -320,0 Z" />

        <!-- Pudding dome: vertical golden gradient (same as desktop icon.svg) -->
        <path android:pathData="M128,192 C128,112 384,112 384,192 L352,320 L160,320 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="256"
                    android:startY="112"
                    android:endX="256"
                    android:endY="320"
                    android:startColor="#FFD54F"
                    android:endColor="#FFB300" />
            </aapt:attr>
        </path>

        <!-- Soft highlight on the dome -->
        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.35"
            android:pathData="M156,160 a100,20 0 1,0 200,0 a100,20 0 1,0 -200,0 Z" />

        <!-- Productivity "P" -->
        <path
            android:strokeColor="#5D4037"
            android:strokeWidth="40"
            android:strokeLineCap="round"
            android:pathData="M208,144 L208,368" />
        <path
            android:strokeColor="#5D4037"
            android:strokeWidth="40"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M208,144 L304,144 A56,56 0 0,1 304,256 L208,256" />
    </group>
</vector>