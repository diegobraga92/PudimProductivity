<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+ runtime notification permission (push notifications, Phase 3) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Foreground service for the focus timer (Phase 4) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PudimProductivity"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PudimProductivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 10: home-screen widgets (Jetpack Glance). The system sends
             APPWIDGET_UPDATE to these receivers; Glance renders the UI and
             handles the actionRunCallback taps (checkboxes) internally. -->
        <receiver
            android:name=".widget.TasksWidgetReceiver"
            android:exported="true"
            android:label="@string/tasks_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tasks_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.HabitsWidgetReceiver"
            android:exported="true"
            android:label="@string/habits_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/habits_widget_info" />
        </receiver>

        <!-- Firebase Cloud Messaging (Phase 3): handles push notifications.
             Requires a Firebase project (google-services.json) to receive real
             messages; the service is harmless without it. -->
        <service
            android:name=".fcm.PudimFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Phase 9b: FileProvider so the camera intent can write the photo
             to app-private storage (androidx.core FileProvider). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.pudimproductivity.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Focus timer foreground service (Phase 4): keeps the countdown
             running and shows a persistent notification when backgrounded. -->
        <service
            android:name=".focus.FocusTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="productivity_focus_timer" />
        </service>
    </application>

</manifest>
